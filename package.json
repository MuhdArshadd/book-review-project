{
  "name": "book-review-project",
  "version": "1.0.0",
  "description": "A portfolio-grade book review web application and JSON API built with Express, MySQL, and EJS",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:production": "node index.js",
    "dev": "nodemon index.js",
    "check": "node scripts/check-project.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run lint && npm run test:ci",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/reset-demo.js",
    "openapi:validate": "node scripts/validate-openapi.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "keywords": [
    "books",
    "reviews",
    "express",
    "mysql",
    "ejs"
  ],
  "author": "Muhd Arshadd",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "8.3.5",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "vite": "8.3.5"
  }
}

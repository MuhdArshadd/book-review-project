NODE_ENV=development
PORT=3000

# Use DATABASE_URL for TiDB Cloud or another hosted MySQL-compatible database.
DATABASE_URL=
DB_SSL=false

# Local MySQL fallback when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booksdb
DB_USERNAME=root
DB_PASSWORD=

APP_ORIGIN=http://localhost:3000
QA_DASHBOARD_ORIGIN=
CSRF_SECRET=replace-with-at-least-32-random-characters

DEMO_MODE=true
DEMO_MAX_BOOKS=200
DEMO_MAX_RATINGS=2000
DEMO_MAX_REVIEWS=2000
LOG_LEVEL=info

# Required only when intentionally running npm run db:seed outside tests.
CONFIRM_DEMO_RESET=

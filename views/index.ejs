<%- include("partials/header") %>

<section class="hero">
  <div class="container hero-content">
    <div>
      <p class="eyebrow">Your reading shelf</p>
      <h1>Books that stay with you.</h1>
      <p class="hero-copy">Build a collection, share a rating, and leave a review for your next great read.</p>
    </div>
    <a class="button" href="/books/new">+ Add a Book</a>
  </div>
</section>

<section class="container collection-section">
  <% if (message) { %>
    <div class="notice success" role="status"><%= message %></div>
  <% } %>

  <div class="section-heading">
    <div>
      <p class="eyebrow">The collection</p>
      <h2><%= books.length %> <%= books.length === 1 ? "book" : "books" %></h2>
    </div>
    <form class="sort-form" action="/books" method="GET">
      <label for="sort">Sort by title</label>
      <select id="sort" name="sort" data-auto-submit>
        <option value="asc" <%= sort === "asc" ? "selected" : "" %>>A to Z</option>
        <option value="desc" <%= sort === "desc" ? "selected" : "" %>>Z to A</option>
      </select>
      <noscript><button class="button button-small" type="submit">Sort</button></noscript>
    </form>
  </div>

  <% if (books.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true">📚</div>
      <h2>Your shelf is waiting</h2>
      <p>Add the first book to begin your collection.</p>
      <a class="button" href="/books/new">Add your first book</a>
    </div>
  <% } else { %>
    <div class="book-grid">
      <% books.forEach((book) => { %>
        <article class="book-card">
          <a class="book-card-link" href="/books/<%= book.id %>">
            <div class="cover-wrap">
              <img src="<%= book.BookImage %>" data-fallback-src="/images/covers/fallback.svg" alt="Cover of <%= book.BookName %>" loading="lazy">
            </div>
            <div class="book-card-body">
              <p class="rating-line" aria-label="Average rating">
                <span aria-hidden="true">★</span>
                <% if (book.dataValues.averageRating !== null) { %>
                  <%= Number(book.dataValues.averageRating).toFixed(1) %>
                <% } else { %>
                  Not rated
                <% } %>
              </p>
              <h3><%= book.BookName %></h3>
              <p class="author">by <%= book.BookAuthor %></p>
              <span class="text-link">Read reviews <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>
